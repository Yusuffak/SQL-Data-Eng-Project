/*
Question: What are the highest-paying skills for data engineers?
- Calculate the median salary for each skill required in
- Focus on remote positions with specified salaries
- Include skill frequency to identify both salary and dem
- Why? Helps identify which skills command the highest co
       how common those skills are, providing a more complet
*/
SELECT 
    s.skills, median (jpf.salary_year_avg)as median_salary,
    COUNT(sj.job_id) AS demand_count
FROM job_postings_fact jpf
INNER JOIN skills_job_dim sj ON jpf.job_id = sj.job_id
INNER JOIN skills_dim s ON sj.skill_id = s.skill_id
WHERE 
    jpf.job_title_short = 'Data Engineer'
    AND jpf.job_work_from_home = TRUE
GROUP BY
    s.skills
ORDER BY
    demand_count DESC
LIMIT 25;


